{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delilah",
  "version": "0.3.0",
  "identifier": "dev.delilah.app",
  "build": {
    "beforeDevCommand": "npm run sidecar:dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Delilah",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:7420 ws://127.0.0.1:7420; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/delilahd"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
